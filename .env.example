# PolicyPulse — copy this file to apps/web/.env before running the app:
#   npm run setup
#
# Never commit .env. Never put real production secrets in this repo. App name,
# branding, roles, permissions, providers, sources, and limits live in the database
# (WorkspaceSettings / RolePermission / StorageConnection / IngestionSource), not here.
# This file contains infrastructure secrets and platform endpoints only.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000
APP_VERSION=0.2.0
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database
# Local default matches docker-compose.yml. Hosted (Supabase):
#   DATABASE_URL = transaction pooler  :6543  (serverless runtime)
#   DIRECT_URL   = session pooler      :5432  (db push / migrate / seed)
# Both Supabase URLs must end with ?sslmode=require. See docs/DEPLOYMENT.md.
# Supabase API keys (publishable/secret) are NOT database URLs and are not used
# by Prisma. Copy the connection strings from Project Settings -> Database.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://hexa:hexa@localhost:5433/hexa?schema=public
DIRECT_URL=postgresql://hexa:hexa@localhost:5433/hexa?schema=public
# Max pg connections per app instance. Set 1–3 on Vercel/serverless.
# DATABASE_POOL_MAX=2

# ---------------------------------------------------------------------------
# Redis (optional until you add queues, caching, or shared rate limits)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auth
# AUTH_SECRET signs the gated demo session only. Supabase Auth owns production
# sessions, SSO, and anonymous guests. The anon key is public; the service role
# key is server-only and must never reach the browser bundle.
# Generate AUTH_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Owner to supply the Supabase URL and keys (pending).
# ---------------------------------------------------------------------------
AUTH_SECRET=replace-me-with-a-32-byte-random-secret

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Demo sign-in is enabled by default outside production. The workspace setting
# demoLoginEnabled is also required. Set DEMO_MODE=true only for a hosted judged
# demo; identity is not verified in demo mode. Demo personas are OWNER sessions.
# DEMO_MODE=true
# Production NEVER honours DEMO_MODE. To host a judged demo in production you
# must set both of the following deliberately (owner sign-off required):
# ALLOW_DEMO_MODE_IN_PRODUCTION=true
# DEMO_MODE=true

# Forwarding headers (x-forwarded-for / x-real-ip) are attacker-controlled.
# Only enable this when a trusted proxy/platform overwrites them. Vercel is
# detected automatically. Authenticated endpoints are keyed by user id instead.
# TRUST_PROXY_HEADERS=true

# ---------------------------------------------------------------------------
# Email
# Local default: Mailpit (docker compose) at http://localhost:8025
# Production options: EMAIL_PROVIDER=gmail (Google OAuth + Gmail API) or
# EMAIL_PROVIDER=resend with RESEND_API_KEY, or EMAIL_PROVIDER=smtp.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
EMAIL_FROM="PolicyPulse <no-reply@hexa.local>"
SMTP_URL=smtp://localhost:1025
# RESEND_API_KEY=re_...
# Sender name, reply-to, and event toggles live in WorkspaceSettings.

# ---------------------------------------------------------------------------
# Gmail API sending (EMAIL_PROVIDER=gmail)
# The app signs users into Google with OAuth 2.0 (Web application) and sends
# through the connected Gmail account. It never uses a Gmail password or an App
# Password. Create the credential in Google Cloud Console, enable the Gmail API,
# and register these authorized redirect URIs:
#   http://localhost:3000/api/integrations/gmail/callback
#   https://<your-vercel-domain>/api/integrations/gmail/callback
# The mailbox connection is created at runtime: Settings -> Email -> Connect Gmail.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: pin the callback origin. Defaults to APP_URL + /api/integrations/gmail/callback.
# GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/integrations/gmail/callback
GMAIL_FROM_NAME=PolicyPulse
# 32-byte key used to encrypt OAuth access/refresh tokens at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Protects GET/POST /api/cron/worker (ingestion, email, reminders). Vercel Cron
# sends it automatically as "Authorization: Bearer $CRON_SECRET". The legacy
# /api/cron/email and /api/cron/watch routes accept the same secret.
# Change this everywhere; generate with: openssl rand -hex 24
CRON_SECRET=local-dev-cron-secret-change-me

# ---------------------------------------------------------------------------
# Regulatory watch
# /api/cron/watch is scheduled weekly in apps/web/vercel.json (Mondays 04:00
# UTC). Manual runs and direct URL fetches use the same SSRF/size/timeout guards.
# ---------------------------------------------------------------------------
# Documents fetched per source per run. Lower it to keep a serverless run fast.
WATCH_MAX_DOCS_PER_RUN=4
# Optional honest user agent for regulator sites.
# WATCH_USER_AGENT=

# ---------------------------------------------------------------------------
# Storage (SharePoint primary; Google Drive / Supabase Storage fallback)
# Provider choice, site/drive/folder/bucket, and the primary/fallback roles live
# in StorageConnection rows edited by owners/admins at /app/settings/storage.
# Only app-only Graph credentials live here. Prefer Sites.Selected consent.
# Setup: docs/STORAGE-SETUP.md
# ---------------------------------------------------------------------------
MSFT_GRAPH_TENANT_ID=
MSFT_GRAPH_CLIENT_ID=
MSFT_GRAPH_CLIENT_SECRET=
# Optional Google Drive adapter: service account JSON, base64-encoded. The
# folder id is saved in the DB; share that folder with the service account.
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# Supabase Storage fallback reuses NEXT_PUBLIC_SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY above; the bucket is saved in the DB.

# ---------------------------------------------------------------------------
# Ingestion sources (actual public URLs only)
# Owner supplies the real listing/direct-PDF URLs here; never hardcode a
# regulator URL or invent one. Comma-separated absolute http(s) URLs. A one-time
# seed imports them into IngestionSource rows (host-derived label, allowlist,
# disabled until the owner reviews/enables). Runtime and UI read the DB, so the
# owner can edit/schedule/disable without a redeploy. If empty, the UI shows
# "No sources yet." — no fabricated source. The owner pastes the actual URLs.
# ---------------------------------------------------------------------------
INGESTION_SOURCE_URLS=

# ---------------------------------------------------------------------------
# Gemini (server-only)
# The API key is never exposed to the client, logged, or sent in an error. The
# model is chosen server-side (ASSISTANT_MODEL) and validated against a server
# allowlist. GEMINI_AUTH_MODE is verified by a real smoke test:
#   api-key -> x-goog-api-key header (default) | bearer -> Authorization header
# Owner inserts the dev key in gitignored apps/web/.env; the prod key is a Vercel
# secret only.
# ASSISTANT_MODEL optionally overrides the grounded assistant model. It must be
# on the server allowlist; otherwise the default gemini-3.5-flash is used
# (measured 2-4s per answer on a 6-passage payload; gemini-3.8-flash regularly
# exceeds the 12s timeout).
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_AUTH_MODE=api-key
# ASSISTANT_MODEL=gemini-3.5-flash

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
# SENTRY_DSN=
