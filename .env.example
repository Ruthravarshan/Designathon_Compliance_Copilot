# Copy this file to apps/web/.env before running the app:
#   npm run setup
#
# Never commit .env. Never put real production secrets in this repo.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000
APP_VERSION=0.1.0
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database
# Local default matches docker-compose.yml. Hosted (Supabase):
#   DATABASE_URL = transaction pooler  :6543  (serverless runtime)
#   DIRECT_URL   = session pooler      :5432  (db push / migrate / seed)
# Both Supabase URLs must end with ?sslmode=require. See docs/DEPLOYMENT.md.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://hexa:hexa@localhost:5433/hexa?schema=public
DIRECT_URL=postgresql://hexa:hexa@localhost:5433/hexa?schema=public
# Max pg connections per app instance. Set 1–3 on Vercel/serverless.
# DATABASE_POOL_MAX=2

# ---------------------------------------------------------------------------
# Redis (optional until you add queues, caching, or shared rate limits)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auth (required once an auth library is selected in Phase 05)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------
AUTH_SECRET=replace-me-with-a-32-byte-random-secret

# Demo sign-in is enabled by default outside production. Set DEMO_MODE=true only
# for a hosted judged demo; identity is not verified in demo mode.
# DEMO_MODE=true

# ---------------------------------------------------------------------------
# Email
# Local default: Mailpit (docker compose) at http://localhost:8025
# Production: set EMAIL_PROVIDER=resend with RESEND_API_KEY, or use SMTP.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
EMAIL_FROM="Hexa <no-reply@hexa.local>"
SMTP_URL=smtp://localhost:1025
# RESEND_API_KEY=re_...

# Protects the email queue processor endpoint (GET or POST /api/cron/email).
# Vercel Cron sends it automatically as "Authorization: Bearer $CRON_SECRET".
# Change this everywhere; generate with: openssl rand -hex 24
CRON_SECRET=local-dev-cron-secret-change-me

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
# SENTRY_DSN=
