generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum EmailStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELED
}

enum GmailStatus {
  CONNECTED
  REVOKED
  ERROR
}

enum StorageProviderKind {
  SHAREPOINT
  SUPABASE_STORAGE
  GOOGLE_DRIVE
}

enum StorageConnectionStatus {
  UNVERIFIED
  CONNECTED
  ERROR
}

enum Regulator {
  RBI
  SEBI
  IRDAI
  MEITY
}

enum WatchTrigger {
  MANUAL
  SCHEDULED
}

enum WatchRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  SKIPPED
}

enum WatchSourceKind {
  LISTING
  FEED
  DIRECT
}

enum PolicyCheckResult {
  COMPLIANT
  AT_RISK
  GAPS
}

enum DocumentStatus {
  INGESTED
  ANALYZED
  ARCHIVED
}

enum EmbeddingStatus {
  PENDING
  READY
  FAILED
  SKIPPED
}

enum ObligationType {
  SECURITY_TESTING
  INCIDENT_REPORTING
  DATA_LOCALIZATION
  CONSENT
  DATA_RETENTION
  THIRD_PARTY_AUDIT
  CRYPTOGRAPHY
  RESILIENCE
  LOGGING
  GOVERNANCE
  GRIEVANCE
  OTHER
}

enum GapStatus {
  COMPLIANT
  PARTIAL_GAP
  CRITICAL_GAP
  MISSING_CONTROL
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ReviewStatus {
  PENDING_REVIEW
  APPROVED
  APPROVED_WITH_EDITS
  REJECTED
  NOT_REQUIRED
}

enum ReviewAction {
  APPROVED
  APPROVED_WITH_EDITS
  REJECTED
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String?
  imageUrl        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  memberships     Membership[]
  auditLogs       AuditLog[]
  emails          EmailMessage[]
  emailPreference EmailPreference?
  reviewedFindings Finding[]       @relation("FindingReviewer")
  reviewEvents     ReviewEvent[]   @relation("ReviewActor")
  gmailConnections GmailAccount[]  @relation("GmailConnectedBy")
  storageConnections StorageConnection[] @relation("StorageConnectionCreator")
}

model Workspace {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  memberships Membership[]
  auditLogs   AuditLog[]
  emails      EmailMessage[]
  documents   RegulatoryDocument[]
  policies    InternalPolicy[]
  controls    InternalControl[]
  obligations Obligation[]
  findings    Finding[]
  reviewEvents ReviewEvent[]
  dataScans   DataFieldScan[]
  gmailAccount GmailAccount?
  storageConnections StorageConnection[]
  sources     RegulatorySource[]
  watchRuns   WatchRun[]
  policyChecks PolicyCheck[]
  revisions   RegulatoryRevision[]
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        Role      @default(MEMBER)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
}

model AuditLog {
  id          String     @id @default(cuid())
  workspaceId String?
  actorId     String?
  action      String
  entity      String
  entityId    String?
  metadata    Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime   @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor       User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
  @@index([entity, entityId])
}

model EmailMessage {
  id                String      @id @default(cuid())
  workspaceId       String?
  userId            String?
  toEmail           String
  template          String
  subject           String
  payload           Json
  status            EmailStatus @default(QUEUED)
  idempotencyKey    String      @unique
  attempts          Int         @default(0)
  lastError         String?
  provider          String?
  providerMessageId String?
  scheduledAt       DateTime    @default(now())
  sentAt            DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  workspace         Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user              User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([toEmail, createdAt])
}

model EmailPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  transactional Boolean  @default(true)
  product       Boolean  @default(true)
  marketing     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailSuppression {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String
  createdAt DateTime @default(now())
}

model GmailAccount {
  id              String      @id @default(cuid())
  workspaceId     String      @unique
  email           String
  accessTokenEnc  String
  refreshTokenEnc String
  tokenType       String      @default("Bearer")
  scope           String
  expiresAt       DateTime
  status          GmailStatus @default(CONNECTED)
  lastErrorCode   String?
  connectedById   String?
  connectedAt     DateTime    @default(now())
  lastRefreshedAt DateTime?
  revokedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedBy     User?       @relation("GmailConnectedBy", fields: [connectedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
}

model StorageConnection {
  id            String                  @id @default(cuid())
  workspaceId   String
  provider      StorageProviderKind
  config        Json                    @default("{}")
  isDefault     Boolean                 @default(false)
  isFallback    Boolean                 @default(false)
  status        StorageConnectionStatus @default(UNVERIFIED)
  lastErrorCode String?
  lastCheckedAt DateTime?
  createdById   String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  workspace     Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     User?                   @relation("StorageConnectionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  documents     RegulatoryDocument[]

  @@unique([workspaceId, provider])
  @@index([workspaceId, isDefault])
  @@index([workspaceId, isFallback])
}

model RegulatoryDocument {
  id          String           @id @default(cuid())
  workspaceId String
  regulator   Regulator
  title       String
  reference   String
  summary     String
  sourceUrl   String
  publishedAt DateTime
  effectiveAt DateTime?
  status      DocumentStatus   @default(INGESTED)
  content     String
  pageCount   Int              @default(1)
  checksum    String
  ingestedAt  DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  sourceId    String?
  filename        String?
  fileContentType String?
  fileChecksum    String?
  fileBytes       Bytes?
  storageConnectionId String?
  storageItemId   String?
  storageWebUrl   String?
  storagePath     String?
  storageModifiedAt DateTime?
  indexStatus     EmbeddingStatus @default(PENDING)
  indexedAt       DateTime?
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source      RegulatorySource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  storageConnection StorageConnection? @relation(fields: [storageConnectionId], references: [id], onDelete: SetNull)
  clauses     DocumentClause[]
  obligations Obligation[]
  findings    Finding[]
  revisions   RegulatoryRevision[]

  @@unique([workspaceId, reference])
  @@index([workspaceId, ingestedAt])
  @@index([workspaceId, regulator, publishedAt])
  @@index([workspaceId, sourceId])
  @@index([workspaceId, storageItemId])
  @@index([workspaceId, indexStatus])
}

model DocumentClause {
  id           String             @id @default(cuid())
  workspaceId  String
  documentId   String
  sectionLabel String
  heading      String?
  pageNumber   Int
  orderIndex   Int
  text         String
  embedding    Unsupported("vector(768)")?
  embeddingModel String?
  embeddedAt   DateTime?
  document     RegulatoryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  obligations  Obligation[]

  @@unique([workspaceId, documentId, orderIndex])
  @@index([workspaceId, documentId])
}

model InternalPolicy {
  id         String    @id @default(cuid())
  workspaceId String
  code       String
  title      String
  version    String
  section    String
  ownerName  String
  ownerEmail String
  text       String
  tags       String[]
  attributes Json
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  findings   Finding[]

  checks     PolicyCheck[]

  @@unique([workspaceId, code])
  @@index([workspaceId])
}

model InternalControl {
  id          String    @id @default(cuid())
  workspaceId String
  code        String
  title       String
  description String
  ownerName   String
  ownerEmail  String
  systemName  String?
  status      String    @default("ACTIVE")
  tags        String[]
  attributes  Json
  lastTestedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  findings    Finding[]

  @@unique([workspaceId, code])
  @@index([workspaceId, status])
}

model Obligation {
  id                   String             @id @default(cuid())
  workspaceId          String
  documentId           String
  clauseId             String
  reference            String
  plainLanguage        String
  actionRequired       String
  applicableTo         String
  obligationType       ObligationType
  requirement          Json
  sla                  String?
  effectiveDeadline    DateTime?
  extractionConfidence Float
  citationVerified     Boolean            @default(false)
  criticNotes          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document             RegulatoryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  clause               DocumentClause     @relation(fields: [clauseId], references: [id], onDelete: Cascade)
  finding              Finding?

  @@unique([workspaceId, reference])
  @@index([workspaceId, obligationType])
  @@index([workspaceId, documentId])
}

model Finding {
  id                   String       @id @default(cuid())
  workspaceId          String
  obligationId         String       @unique
  documentId           String
  policyId             String?
  controlId            String?
  status               GapStatus
  severity             Severity
  gapDescription       String
  severityRationale    String?
  citationVerified     Boolean      @default(false)
  extractionConfidence Float
  mappingConfidence    Float
  confidence           Float
  dueDate              DateTime
  redlineBefore        String
  redlineAfter         String
  approvedWording      String?
  taskTitle            String?
  taskAssignee         String?
  taskAssigneeEmail    String?
  taskDueDate          DateTime?
  reviewStatus         ReviewStatus @default(PENDING_REVIEW)
  reviewerId           String?
  reviewerName         String?
  reviewedAt           DateTime?
  reviewComments       String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  workspace            Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  obligation           Obligation   @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  document             RegulatoryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  policy               InternalPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  control              InternalControl? @relation(fields: [controlId], references: [id], onDelete: SetNull)
  reviewer             User?        @relation("FindingReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviews              ReviewEvent[]

  @@index([workspaceId, reviewStatus, severity])
  @@index([workspaceId, dueDate])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, documentId])
}

model ReviewEvent {
  id           String       @id @default(cuid())
  workspaceId  String
  findingId    String
  actorId      String?
  actorName    String
  actorRole    Role
  action       ReviewAction
  previous     Json
  updated      Json
  comments     String
  createdAt    DateTime     @default(now())
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  finding      Finding      @relation(fields: [findingId], references: [id], onDelete: Cascade)
  actor        User?        @relation("ReviewActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([findingId, createdAt])
}

model DataFieldScan {
  id           String    @id @default(cuid())
  workspaceId  String
  datasetName  String
  fieldName    String
  dataCategory String
  sensitiveType String?
  sampleMasked String?
  encrypted    Boolean
  consented    Boolean
  riskLevel    Severity
  finding      String
  citation     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, datasetName, fieldName])
  @@index([workspaceId, riskLevel])
}

model RegulatorySource {
  id            String          @id @default(cuid())
  workspaceId   String
  name          String
  regulator     Regulator
  kind          WatchSourceKind @default(LISTING)
  listingUrl    String
  allowedDomains String[]
  linkPattern   String?
  schedule      String          @default("weekly")
  enabled       Boolean         @default(true)
  lastCheckedAt DateTime?
  lastStatus    WatchRunStatus?
  lastItemCount Int             @default(0)
  lastErrorCode String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents     RegulatoryDocument[]
  runs          WatchRun[]

  @@unique([workspaceId, listingUrl])
  @@index([workspaceId, enabled])
}

model WatchRun {
  id              String          @id @default(cuid())
  workspaceId     String
  sourceId        String?
  trigger         WatchTrigger
  status          WatchRunStatus  @default(RUNNING)
  discovered      Int             @default(0)
  ingested        Int             @default(0)
  skipped         Int             @default(0)
  failed          Int             @default(0)
  revisions       Int             @default(0)
  newFindings     Int             @default(0)
  overdueCritical Int             @default(0)
  overdueHigh     Int             @default(0)
  summary         Json?
  errorCode       String?
  triggeredById   String?
  triggeredByName String?
  startedAt       DateTime        @default(now())
  finishedAt      DateTime?
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source          RegulatorySource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, startedAt])
  @@index([sourceId, startedAt])
}

model PolicyCheck {
  id           String            @id @default(cuid())
  workspaceId  String
  policyId     String
  result       PolicyCheckResult
  score        Int
  openFindings Int               @default(0)
  critical     Int               @default(0)
  high         Int               @default(0)
  medium       Int               @default(0)
  low          Int               @default(0)
  overdue      Int               @default(0)
  summary      String
  details      Json?
  actorId      String?
  actorName    String?
  trigger      WatchTrigger      @default(MANUAL)
  createdAt    DateTime          @default(now())
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  policy       InternalPolicy    @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([policyId, createdAt])
}

model RegulatoryRevision {
  id               String   @id @default(cuid())
  workspaceId      String
  documentId       String
  previousChecksum String
  newChecksum      String
  previousContent  String
  newContent       String
  summary          String
  diff             Json
  detectedAt       DateTime @default(now())
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document         RegulatoryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([workspaceId, detectedAt])
  @@index([documentId, detectedAt])
}
