using './main.bicep'

// Example parameter file for PolicyPulse Azure deployment (NOT applied automatically).
// Supply secrets via Azure Key Vault / CI OIDC / environment variables — never commit real secrets.

param environment = 'prod'
param location = 'centralindia'
param workloadName = 'policypulse'
param imageTag = '0.2.0'
param appUrl = 'https://policypulse.example.com'
param postgresAdminLogin = 'policypulseadmin'
param postgresAdminPassword = '<replace-via-secure-param-or-env>'
param authSecret = '<replace-with-32-byte-base64>'
param cronSecret = '<replace-with-24-byte-hex>'
param tokenEncryptionKey = '<replace-with-32-byte-base64>'
param geminiApiKey = ''
param msftGraphClientSecret = ''
param msftGraphTenantId = ''
param msftGraphClientId = ''
param ingestionSourceUrls = ''
param enableHighAvailability = true
param minReplicas = 2
param maxReplicas = 10
